---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const date = new Intl.DateTimeFormat("en-GB", { dateStyle: "long" });
---

<Base title="Blog" description="Notes on getting paid, running a small business and building Sahel.">
  <div class="container stack narrow">
    <section class="panel page-head reveal">
      <h1 class="heading">Blog</h1>
      <span class="badge plain">{posts.length} posts</span>
    </section>
    <ul class="panel post-list">
      {
        posts.map((post, i) => (
          <li class="reveal" style={`--delay: ${40 + i * 40}ms`}>
            <a href={`/blog/${post.id}`} class="hoverable">
              <time class="label mono" datetime={post.data.date.toISOString()}>
                {date.format(post.data.date)}
              </time>
              <h2 class="subheading">{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Base>
