---
import Base from "../../layouts/Base.astro";
import { getCollection } from "astro:content";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const date = new Intl.DateTimeFormat("en-GB", { dateStyle: "long" });
---

<Base title="Blog" description="Notes on getting paid, running a small business and building Acme.">
  <section class="container section narrow">
    <h1>Blog</h1>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li>
            <a href={`/blog/${post.id}`}>
              <time datetime={post.data.date.toISOString()}>{date.format(post.data.date)}</time>
              <h2>{post.data.title}</h2>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
