---
import Base from "../layouts/Base.astro";
import Feature from "../components/Feature.astro";
import HeroArt from "../components/HeroArt.astro";
import { getCollection } from "astro:content";
import { SITE } from "../site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const date = new Intl.DateTimeFormat("en-GB", { dateStyle: "medium" });
---

<Base>
  <div class="container stack">
    <section class="panel hero">
      <div class="hero-copy">
        <p class="eyebrow reveal"><span class="badge accent">New</span> Automatic reminders on WhatsApp</p>
        <h1 class="title reveal" style="--delay: 40ms">{SITE.tagline}</h1>
        <p class="lede reveal" style="--delay: 80ms">{SITE.description}</p>
        <div class="actions reveal" style="--delay: 120ms">
          <a href={SITE.cta.href} class="btn btn-primary btn-lg">{SITE.cta.label}</a>
          <a href="#features" class="btn btn-lg">See how it works</a>
        </div>
        <p class="note reveal" style="--delay: 160ms">Free for your first 20 invoices a month. No card needed.</p>
      </div>
      <HeroArt />
    </section>

    <section class="panel proof" aria-label="Customers">
      <p>Trusted by 2,000 small businesses across Africa</p>
      <ul>
        <li>Kinetic</li>
        <li>Baobab & Co</li>
        <li>Northwind</li>
        <li>Savanna Labs</li>
        <li>Lumen</li>
      </ul>
    </section>

    <section id="features" class="section">
      <h2 class="section-title rise">Everything between “sent” and “paid”</h2>
      <div class="features">
        <Feature title="Send in seconds" n={1}>Pick a customer, add line items, send. Your logo, your colours, their currency.</Feature>
        <Feature title="Chase on autopilot" n={2}>Polite reminders go out before and after the due date, by email or WhatsApp.</Feature>
        <Feature title="Paid by card or transfer" n={3}>Every invoice carries a payment link. Money lands in your account, not ours.</Feature>
        <Feature title="Books that balance" n={4}>Payments match their invoices on their own, ready for your accountant.</Feature>
      </div>
    </section>

    <section class="panel hatch quote rise">
      <blockquote>
        “We used to spend Fridays chasing payments. Now Sahel does it, and we get paid nine days sooner on average.”
      </blockquote>
      <p><span class="tile">AE</span>Amaka Eze, founder of Baobab & Co</p>
    </section>

    {
      posts.length > 0 && (
        <section class="section">
          <div class="section-head rise">
            <h2 class="section-title">From the blog</h2>
            <a href="/blog">All posts →</a>
          </div>
          <div class="posts">
            {posts.map((post) => (
              <a href={`/blog/${post.id}`} class="panel post-card hoverable rise">
                <time class="label mono" datetime={post.data.date.toISOString()}>
                  {date.format(post.data.date)}
                </time>
                <h3 class="subheading">{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            ))}
          </div>
        </section>
      )
    }

    <section class="panel cta rise">
      <h2 class="heading">Get paid for the work you've already done.</h2>
      <a href={SITE.cta.href} class="btn btn-lg cta-btn">{SITE.cta.label}</a>
    </section>
  </div>
</Base>
