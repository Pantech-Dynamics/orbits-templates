---
import { SITE } from "../site";
---

<footer class="footer">
  <div class="container footer-row">
    <p><span class="tile">{SITE.name.slice(0, 1)}</span>© {new Date().getFullYear()} {SITE.name}</p>
    <nav aria-label="Footer">
      {SITE.nav.map(({ href, label }) => <a href={href}>{label}</a>)}
      <a href="/rss.xml">RSS</a>
    </nav>
  </div>
</footer>
