---
import { SITE } from "../site";
const path = Astro.url.pathname;
---

<header class="header">
  <div class="container header-row">
    <a href="/" class="brand"><span class="mark" aria-hidden="true"></span>{SITE.name}</a>
    <nav aria-label="Main">
      {SITE.nav.map(({ href, label }) => <a href={href} aria-current={path.startsWith(href) && href !== "/" ? "page" : undefined}>{label}</a>)}
    </nav>
    <a href={SITE.cta.href} class="button small">{SITE.cta.label}</a>
  </div>
</header>
